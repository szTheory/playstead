<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Local recovery proof only: it deliberately excludes the restricted
	     virtual-controller entitlement used by the broad hardware UI target. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>

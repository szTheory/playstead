<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Targeted local UI tests that do not create a virtual controller can use
	     ad-hoc signing without the Apple-approved virtual HID entitlement. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>

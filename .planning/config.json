  "hooks": {
    "context_warnings": true
  },
  "project_code": null,
  "phase_naming": "sequential",
  "agent_skills": {},
  "claude_md_path": "./.claude/CLAUDE.md",
  "plan_review": {
    "source_grounding": true,
    "source_grounding_authority": "grep"
  },
  "mode": "yolo",
  "granularity": "coarse",
  "intel": {
    "enabled": false
  },
  "graphify": {
    "enabled": false
  },
  "resolve_model_ids": true,
  "runtime": "codex",
  "model_policy": {
    "provider": "openai",
    "budget": "high",
    "high": "gpt-5.6-sol",
    "medium": "gpt-5.6-sol",
    "low": "gpt-5.6-sol"
  },
  "model_profile_overrides": {
    "codex": {
      "opus": "gpt-5.6-sol",
      "sonnet": "gpt-5.6-sol",
      "haiku": "gpt-5.6-sol"
    }
  },
  "effort": {

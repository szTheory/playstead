# Playstead server environment.
#
# Copy this file to .env, replace every REPLACE_WITH_* placeholder
# with a real generated value, then `docker compose up -d`.
#
# The application refuses to boot if SECRET_KEY_BASE or
# POSTGRES_PASSWORD still hold their placeholder values below -- there
# is no working default credential anywhere in this file.

# --- Secrets (generate real values -- the app refuses to boot on placeholders) ---

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=REPLACE_WITH_GENERATED_SECRET_KEY_BASE

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- Database ---

POSTGRES_USER=playstead
POSTGRES_DB=playstead
# Must match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above.
DATABASE_URL=ecto://playstead:REPLACE_WITH_STRONG_PASSWORD@db/playstead

# --- Host / networking ---

# The hostname clients use to reach this server. Set this to your real
# domain in production; localhost is fine for local-only access.
PHX_HOST=localhost

# When set to a real domain, Caddy automatically obtains a Let's
# Encrypt certificate for it. Leave unset for Caddy's own internal CA
# (locally-trusted, no domain required).
PLAYSTEAD_DOMAIN=

# Host ports Caddy publishes. Only Caddy publishes host ports -- db and
# app are reachable only on the internal compose network.
PLAYSTEAD_HTTP_PORT=80
PLAYSTEAD_HTTPS_PORT=443

# "external" documents (does not implement) bring-your-own reverse
# proxy as a supported alternative to the bundled Caddy -- see
# docs/DEPLOY.md. Leave unset to use the bundled Caddy (the default).
PLAYSTEAD_PROXY=

# --- First-run setup ---

# Documented automation override for the setup-token bootstrap (D-03).
# Leave unset to use the token printed to container stdout logs on
# first boot instead.
PLAYSTEAD_SETUP_TOKEN=

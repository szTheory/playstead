# Private config default: ~/.config/playstead/first-adopter/first-adopter.env.
# Keep this file private (chmod 600). Replace every example value before use.
POSTGRES_USER=playstead_owner
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD
POSTGRES_DB=playstead_owner
DATABASE_URL=ecto://playstead_owner:REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD@db/playstead_owner
SECRET_KEY_BASE=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_KEY_BASE
PLAYSTEAD_SETUP_TOKEN=REPLACE_WITH_A_UNIQUE_RANDOM_SETUP_TOKEN

# Use the server Mac's LAN IPv4 address. Reserve it in the router's DHCP
# settings so the second Mac keeps finding the same server. The value below
# is TEST-NET documentation space; replace it on your private copy only.
PHX_HOST=192.0.2.10
PLAYSTEAD_DOMAIN=
PLAYSTEAD_CADDY_SITE_ADDRESS=192.0.2.10

# Bind only to the server Mac's LAN IPv4 address. Do not use 0.0.0.0.
PLAYSTEAD_BIND_ADDRESS=192.0.2.10
PLAYSTEAD_HTTP_PORT=8080
PLAYSTEAD_HTTPS_PORT=8443

# Use distinct absolute paths outside this checkout and outside all QA data.
PLAYSTEAD_INBOX_HOST_PATH=/Users/REPLACE_WITH_YOUR_ACCOUNT/Playstead-First-Adopter/inbox
PLAYSTEAD_EXPORT_HOST_PATH=/Users/REPLACE_WITH_YOUR_ACCOUNT/Playstead-First-Adopter/exports
PLAYSTEAD_BACKUP_HOST_PATH=/Users/REPLACE_WITH_YOUR_ACCOUNT/Playstead-First-Adopter/backups

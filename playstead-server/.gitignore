# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
playstead-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Real secrets live here, generated from .env.example — never commit this.
/.env


# Platform-specific esbuild/tailwind binaries downloaded by their Mix tasks.
/esbuild-*
/tailwind-*

# The dev inbox (config/runtime.exs points :inbox_path here in :dev, and
# docker-compose bind-mounts it read-only at /app/inbox). The ROMs you drop
# in are yours, not the repo's.
#
# An empty .gitkeep -- NOT a README -- keeps the folder present on a fresh
# clone. Playstead.Import.Inbox.scan/1 skips dot-entries but reports every
# other regular file, so a tracked README.md here was scanned as the
# operator's content and reported as an unknown file on every single inbox
# preview. The project must not ship content into a folder it has told the
# operator is theirs; see docs/INBOX.md.
/inbox/*
!/inbox/.gitkeep

# Setup token generated by scripts/dev-up.sh for the local dev stack.
/.dev-setup-token

# Blob storage for the native dev path (scripts/dev-up.sh --native sets
# PLAYSTEAD_BLOB_PATH here). These are library bytes, not repo content.
/blobs/

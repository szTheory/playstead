{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "playstead.backup-set.v1",
  "title": "Playstead backup-set receipt and manifest",
  "type": "object",
  "required": ["schema", "id", "kind", "correlation_id", "coverage"],
  "properties": {
    "schema": {"const": "playstead.backup-set.v1"},
    "id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["full", "incremental"]},
    "correlation_id": {"type": "string", "minLength": 1},
    "parent": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "required": ["receipt_id"], "properties": {"receipt_id": {"type": "string"}}}
      ]
    },
    "coverage": {
      "type": "object",
      "required": ["inventory_count", "entries", "release", "configuration"],
      "properties": {
        "inventory_count": {"type": "integer", "minimum": 0},
        "entries": {"type": "array", "minItems": 1},
        "release": {"type": "string"},
        "configuration": {"type": "object"}
      }
    }
  }
}
